# Copy to .env and provide secrets locally. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional, opt-in: exactly four distinct priced NVIDIA Nemotron IDs; one vote per model.
# Fits a five-call run only when no more than one provider attempt was used before intent review.
# Never confirms author intent automatically.
INTENT_REVIEW_MODELS=
INFERENCE_BUDGET_USD=20
INFERENCE_RUN_BUDGET_USD=0.25
INFERENCE_MAX_CALLS_PER_RUN=5
# Generate unique secrets locally (for example: openssl rand -hex 32).
API_ACCESS_TOKEN=replace-with-a-random-secret
GITHUB_TOKEN=
GPU_WORKER_TOKEN=replace-with-a-random-secret
PUBLIC_API_URL=http://hari-dell-g15-5510.tail8849b3.ts.net:8000
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://hari-dell-g15-5510.tail8849b3.ts.net:3000,http://localhost:3000
DOCKER_GID=999
